#!/usr/bin/env bash
#
# jollyfin-cli - configure the real, running JollyFin app on this same
# device from Termux: read/write its actual download settings, browse the
# Jellyfin/Sonarr/Radarr/Seerr libraries, trigger real downloads (by item id
# or by show/movie name) through its own Downloader, and debug-proxy
# requests to Jellyfin/Sonarr/Radarr/Seerr using its own already-stored
# credentials. This CLI only ever talks to the local app - it is not a
# standalone Jellyfin client and does not manage other devices.
#
# Transport: a plain loopback HTTP server the app runs on 127.0.0.1 only
# (see Settings > Local CLI access to enable it and get a token). This is
# the third transport tried for this feature - two prior attempts hit
# real, unfixable-at-the-app-level walls on a real device:
#   1. A Linux abstract-namespace unix socket - SELinux blocks arbitrary
#      app-to-app connections outright (confirmed: EACCES under
#      enforcing, the normal state; works under permissive).
#   2. A ContentProvider invoked via Android's `content call` shell
#      command - works, but that command's *external*-access path needs
#      android.permission.ACCESS_CONTENT_PROVIDERS_EXTERNALLY, a
#      signature-level permission only the shell/root uid can ever hold
#      (confirmed: `pm grant` refuses it even as root).
# Loopback TCP has neither problem - it's ordinary socket I/O gated only
# by the INTERNET permission the app already has - so this needs no root
# and no extra Termux packages beyond curl/jq, which almost every Termux
# install already has.

set -euo pipefail

# Bump on every meaningful change to this script (new command, changed flag/behavior, bugfix
# worth being able to tell apart) - "jollyfin-cli version" reports this alongside the app's own
# versionName/versionCode/gitRevision, so a mismatch between what a user has installed and what's
# current is visible at a glance.
CLI_VERSION="1.2.0"

CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/jollyfin-cli"
TOKEN_FILE="${CONFIG_DIR}/local_token"
# Used by "start" (the app isn't running yet, so there's nothing to ask over the local control
# API - this has to go through Android's activity manager instead), and now also to pick the
# right default port below. Override for a debug/staging install (applicationIdSuffix
# ".debug"/".staging").
PACKAGE_NAME="${JOLLYFIN_PACKAGE_NAME:-dev.pschmitt.jollyfin}"
# Debug/staging installs bind their own port (BASE_PORT+1/+2 - see
# LocalControlServer.portFor()) so they can run side by side with a release install without one
# variant's server failing to bind because another already grabbed the port. Derived from
# PACKAGE_NAME's suffix so setting JOLLYFIN_PACKAGE_NAME alone is enough to target a debug/
# staging install - JOLLYFIN_LOCAL_URL still wins outright if set, for anything unusual (a
# forwarded port, a non-default install, etc).
case "${PACKAGE_NAME}" in
  *.debug) DEFAULT_LOCAL_PORT=48412 ;;
  *.staging) DEFAULT_LOCAL_PORT=48413 ;;
  *) DEFAULT_LOCAL_PORT=48411 ;;
esac
BASE_URL="${JOLLYFIN_LOCAL_URL:-http://127.0.0.1:${DEFAULT_LOCAL_PORT}}"
# The app's applicationId ("dev.pschmitt.jollyfin", above) is distinct from its Kotlin/
# manifest namespace ("dev.pschmitt.jellyfin" - see app/phone/build.gradle.kts's "namespace",
# unchanged across every build variant/applicationIdSuffix) - so the launcher activity's real
# component is always "<applicationId>/dev.pschmitt.jellyfin.MainActivity", not
# "<applicationId>/<applicationId>.MainActivity" (FINDROID-61 renamed the namespace's org from
# upstream Findroid's "dev.jdtech" to this fork's own "dev.pschmitt", but applicationId and
# namespace were never required to match, and still don't).
MAIN_ACTIVITY="dev.pschmitt.jellyfin.MainActivity"

# Set from --json by main() (never `local` there, so this stays a real global).
JSON_OUTPUT=""

usage() {
  cat <<EOF
