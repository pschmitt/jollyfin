# jollyfin-cli webui SERVICE [--tvdb ID] [--tmdb ID] [--movie] [--open] - resolves a link into
# Sonarr's/Radarr's/Seerr's own web UI via the app's configured base URL.
cmd_webui() {
  local service="" tvdb_id="" tmdb_id="" type="" open_url=""

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --tvdb)
        tvdb_id="${2:-}"
        shift 2
        ;;
      --tmdb)
        tmdb_id="${2:-}"
        shift 2
        ;;
      --movie)
        type="movie"
        shift
        ;;
      --open)
        open_url=1
        shift
        ;;
      sonarr|radarr|seerr)
        service="$1"
        shift
        ;;
      *)
        printf 'Unknown option: %s\n' "$1" >&2
        return 2
        ;;
    esac
  done

  if [[ -z "${service}" ]]
  then
    printf 'webui requires SERVICE (sonarr|radarr|seerr)\n' >&2
    return 2
  fi

  local response
  response=$(local_request "GET" "/pvr/webui$(build_query "service=${service}" "tvdbId=${tvdb_id}" "tmdbId=${tmdb_id}" "type=${type}")")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
  else
    check_response "${response}" || return 1
    jq -r '.body.url' <<< "${response}"
  fi

  if [[ -n "${open_url}" ]]
  then
    check_response "${response}" || return 1
    if ! command -v termux-open-url >/dev/null 2>&1
    then
      printf 'termux-open-url not found (pkg install termux-tools)\n' >&2
      return 1
    fi
    termux-open-url "$(jq -r '.body.url' <<< "${response}")"
  fi
}

# jollyfin-cli download list [--active|--completed] - one row per downloaded source (movies and,
# unlike the app's own getDownloads() alone, every downloaded episode too). --active shows only
# in-progress transfers (with live percent/speed/eta); --completed shows only finished ones;
# neither flag shows both.
cmd_download_list() {
  local status=""

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --active)
        status="downloading"
        shift
        ;;
      --completed)
        status="completed"
        shift
        ;;
      *)
        printf 'Unknown option: %s\n' "$1" >&2
        return 2
        ;;
    esac
  done

  local response
  response=$(local_request "GET" "/downloads$(build_query "status=${status}")")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'ITEM_ID\tNAME\tSTATUS\tPROGRESS\tSIZE_MIB\tDOWNLOAD_ID\n'
    jq -r '
      .body[] |
      [
        .itemId,
        (if .seriesName then "\(.seriesName) - \(.name) (S\(.seasonNumber)E\(.episodeNumber))" else .name end),
        .status,
        (if .status == "downloading" then "\(.percent)%" else "-" end),
        ((.sizeBytes / 1048576 * 10 | round) / 10 | tostring),
        (.downloadId // "-")
      ] | @tsv
    ' <<< "${response}"
  } | print_table
}

# jollyfin-cli download cancel DOWNLOAD_ID - stops an in-progress transfer (from "download list"'s
# DOWNLOAD_ID column) and cleans up its partial file, same as the app's own Downloads screen.
cmd_download_cancel() {
  local download_id="${1:-}"

  if [[ -z "${download_id}" ]]
  then
    printf 'download cancel requires a DOWNLOAD_ID (from "download list")\n' >&2
    return 2
  fi

  local body
  body=$(jq -n --arg downloadId "${download_id}" '{downloadId: $downloadId}')

  local response
  response=$(local_request "POST" "/downloads/cancel" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  printf 'Cancelled download %s\n' "${download_id}"
}

# jollyfin-cli download remove ITEM_ID [ITEM_ID...] - deletes an already-downloaded item (from
# "download list"'s ITEM_ID column), same cascade as the app's own Downloads screen delete. For an
# in-progress download, use "download cancel" instead.
cmd_download_remove() {
  if [[ $# -eq 0 ]]
  then
    printf 'download remove requires at least one ITEM_ID (from "download list")\n' >&2
    return 2
  fi

  local body
  if [[ $# -eq 1 ]]
  then
    body=$(jq -n --arg itemId "$1" '{itemId: $itemId}')
  else
    body=$(jq -n --args '{itemIds: $ARGS.positional}' -- "$@")
  fi

  local response
  response=$(local_request "POST" "/downloads/remove" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  printf 'Removed %s item(s)\n' "$(jq -r '.body.removed' <<< "${response}")"
}

cmd_download_trigger() {
  local item_id="${1:-}"
  local source_id="${2:-}"

  if [[ -z "${item_id}" ]]
  then
    printf 'download trigger requires an item id\n' >&2
    return 2
  fi

  local body
  if [[ -n "${source_id}" ]]
  then
    body=$(jq -n --arg itemId "${item_id}" --arg sourceId "${source_id}" '{itemId: $itemId, sourceId: $sourceId}')
  else
    body=$(jq -n --arg itemId "${item_id}" '{itemId: $itemId}')
  fi

  local response
  response=$(local_request "POST" "/downloads/trigger" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'DOWNLOAD_ID\n'
    jq -r '[.body.downloadId] | @tsv' <<< "${response}"
  } | print_table
}

# jollyfin-cli download NAME [SEASON] [EPISODE] [--all] - resolves a movie/show by name (and,
# for a show, a season/episode by number or name) and triggers the matching download(s). A bare
# show name with no season needs --all, so a typo/too-broad match can't silently kick off
# downloading an entire series.
cmd_download_by_name() {
  local positional=() all="false" arg

  for arg in "$@"
  do
    if [[ "${arg}" == "--all" ]]
    then
      all="true"
    else
      positional+=("${arg}")
    fi
  done

  local name="${positional[0]:-}"

  if [[ -z "${name}" ]]
  then
    printf 'download requires a show/movie/episode name or item id (or "download list")\n' >&2
    return 2
  fi

  # A bare item id (copied from "library browse"/"search" output) works here too - forward
  # straight to the id-based trigger instead of searching for a literal UUID as if it were a title.
  if [[ "${name}" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
  then
    cmd_download_trigger "${positional[@]}"
    return
  fi

  local season="${positional[1]:-}"
  local episode="${positional[2]:-}"

  local body
  body=$(
    jq -n \
      --arg query "${name}" \
      --arg season "${season}" \
      --arg episode "${episode}" \
      --argjson all "${all}" \
      '{query: $query, all: $all} +
       (if $season != "" then {season: $season} else {} end) +
       (if $episode != "" then {episode: $episode} else {} end)'
  )

  local response
  response=$(local_request "POST" "/downloads/trigger-by-name" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi

  # Some episodes in a batch can fail (e.g. no media source) while others succeed - when the
  # response carries a per-item "triggered" array at all, show every row's own result/error
  # regardless of the overall HTTP status, instead of check_response's blanket "unknown error".
  if jq -e '.body.triggered' <<< "${response}" >/dev/null 2>&1
  then
    local status
    status=$(jq -r '.status' <<< "${response}")
    {
      printf 'ITEM_ID\tNAME\tDOWNLOAD_ID\n'
      jq -r '.body.triggered[] | [.itemId, .name, (.downloadId // .error // "-")] | @tsv' <<< "${response}"
    } | print_table
    [[ "${status}" -ge 200 && "${status}" -lt 300 ]]
  else
    check_response "${response}" || return 1
  fi
}

# Unlike the other commands, a non-2xx response here is still useful output (e.g. Sonarr's own
# 404) rather than a CLI-level failure, so this prints the status and whatever body came back
# instead of calling check_response.
cmd_debug() {
  local service="${1:-}"
  local method="${2:-GET}"
  local path="${3:-}"
  local body_json="${4:-null}"

  if [[ -z "${service}" || -z "${path}" ]]
  then
    printf 'debug requires SERVICE and PATH (jellyfin|sonarr|radarr|seerr)\n' >&2
    return 2
  fi

  local body
  body=$(
    jq -n \
      --arg service "${service}" \
      --arg method "${method}" \
      --arg path "${path}" \
      --argjson requestBody "${body_json}" \
      '{service: $service, method: $method, path: $path, body: $requestBody}'
  )

  local response status
  response=$(local_request "POST" "/debug/proxy" "${body}")
  status=$(jq -r '.status' <<< "${response}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    # Status still goes to stderr here (unlike print_response_json) - for "debug" it's the
    # proxied service's own HTTP code (e.g. Sonarr's real 404), not local-control noise.
    printf 'HTTP %s\n' "${status}" >&2
    jq '.body' <<< "${response}"
    return
  fi
  printf 'HTTP %s\n' "${status}" >&2
  jq -r '.body.body // .body.error // empty' <<< "${response}"
}

# jollyfin-cli version - always shows this script's own CLI_VERSION, even with no token
# configured or the app unreachable (useful on its own for "am I up to date" checks), then
# attempts GET /info for the running app's own versionName/versionCode/gitRevision. Reaching the
# app failing (no token, app not running/local control disabled) is reported on stderr by
# local_request/check_response themselves, same as every other command - not a hard failure here,
# so the command still exits 0 having shown at least the CLI's own version.
cmd_version() {
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    jq -n --arg cliVersion "${CLI_VERSION}" '{cliVersion: $cliVersion}'
    local response
    if response=$(local_request "GET" "/info")
    then
      print_response_json "${response}"
    fi
    return 0
  fi

  printf 'jollyfin-cli: %s\n' "${CLI_VERSION}"

  local response
  if ! response=$(local_request "GET" "/info")
  then
    return 0
  fi
  if ! check_response "${response}"
  then
    return 0
  fi
  {
    printf 'KEY\tVALUE\n'
    jq -r '.body | to_entries[] | [.key, .value] | @tsv' <<< "${response}"
  } | print_table
}

# jollyfin-cli start - launches the app via "am start". There's nothing running yet to ask over
# the local control API in this case (that's the whole point), so this is the one command that
# doesn't go through local_request at all - it shells out to Android's own activity manager
# directly, exactly like tapping the launcher icon would. Plain "am start" from an unprivileged
# Termux process (no root, no adb shell) works as long as Termux itself is in the foreground at
# the moment the command runs (an active terminal session counts) - Android's background-activity-
# start restrictions only block launches from processes with no visible UI.
cmd_start() {
  if ! command -v am >/dev/null 2>&1
  then
    printf 'am not found - "start" needs Android'\''s activity manager, not available in this environment\n' >&2
    return 2
  fi
  am start -n "${PACKAGE_NAME}/${MAIN_ACTIVITY}" >/dev/null
  printf 'Started %s\n' "${PACKAGE_NAME}"
}

# jollyfin-cli stop - there's no OS-level way for an unprivileged process to force-stop another
# app (android.permission.FORCE_STOP_PACKAGES is signature/privileged-only - confirmed even "pm
# grant" as root refuses it, same wall the old ContentProvider transport hit for
# ACCESS_CONTENT_PROVIDERS_EXTERNALLY). POST /app/stop instead asks the running app to exit
# itself - no special permission needed for that, just a normal process calling Runtime.exit() on
# its own PID.
cmd_stop() {
  local response
  response=$(local_request "POST" "/app/stop")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  printf 'Stopping %s\n' "${PACKAGE_NAME}"
}

# jollyfin-cli update - self-update by fetching the app's own bundled jollyfin-cli script over
# the local control server's one unauthenticated route (GET /cli - LocalControlServer.CLI_PATH,
# the exact asset "curl .../cli -o jollyfin-cli" bootstraps from, copied from this very file at
# build time). Like "start", this bypasses local_request entirely - no token needed, and the
# response is a plain script, not JSON. Trusted only after it looks like a real script (shebang +
# a CLI_VERSION= line), and skipped entirely if that version already matches this process's own
# CLI_VERSION (--force bypasses the skip, e.g. to recover from a corrupted install).
cmd_update() {
  local force=""
  case "${1:-}" in
    --force) force=1 ;;
  esac

  local response http_status body
  if ! response=$(curl -sS -w '\n%{http_code}' "${BASE_URL}/cli")
  then
    printf 'No response from JollyFin local control (is it enabled? URL: %s/cli)\n' "${BASE_URL}" >&2
    return 1
  fi
  http_status="${response##*$'\n'}"
  body="${response%$'\n'*}"

  if [[ "${http_status}" -lt 200 || "${http_status}" -ge 300 ]]
  then
    printf 'Update failed (HTTP %s)\n' "${http_status}" >&2
    return 1
  fi

  if [[ "${body}" != '#!'* ]] || ! grep -q '^CLI_VERSION=' <<< "${body}"
  then
    printf 'Update failed: response from %s/cli does not look like jollyfin-cli\n' "${BASE_URL}" >&2
    return 1
  fi

  local new_version
  new_version=$(grep -m1 '^CLI_VERSION=' <<< "${body}" | cut -d'"' -f2)

  if [[ "${new_version}" == "${CLI_VERSION}" && -z "${force}" ]]
  then
    if [[ -n "${JSON_OUTPUT}" ]]
    then
      jq -n --arg v "${CLI_VERSION}" '{updated: false, version: $v}'
    else
      printf 'Already up to date (%s)\n' "${CLI_VERSION}"
    fi
    return 0
  fi

  # Resolves through a PATH symlink to the real file, so the actual installed copy gets
  # overwritten rather than a symlink replaced with a plain file. Written to a temp file in the
  # same directory first (guarantees the final `mv` is same-filesystem, so it's atomic) rather
  # than writing self_path directly, which would truncate a running/about-to-run script.
  local self_path tmp_path
  self_path=$(readlink -f "$0" 2>/dev/null) || self_path="$0"
  tmp_path="${self_path}.new.$$"

  printf '%s' "${body}" > "${tmp_path}"
  chmod +x "${tmp_path}"
  mv "${tmp_path}" "${self_path}"

  if [[ -n "${JSON_OUTPUT}" ]]
  then
    jq -n --arg from "${CLI_VERSION}" --arg to "${new_version}" --arg path "${self_path}" \
      '{updated: true, from: $from, to: $to, path: $path}'
  else
    printf 'Upgraded jollyfin-cli from %s to %s (%s)\n' "${CLI_VERSION}" "${new_version}" "${self_path}"
  fi
}

# Renders a `{status, body: [{id, seriesName, seasonNumber, ...}]}` local_request response
# (autodownload list/add share this shape) as a table.
render_autodownload_rules_table() {
  local response="$1"

  {
    printf 'ID\tSHOW\tSCOPE\tENABLED\tONLY_NEW\tONLY_UNWATCHED\n'
    jq -r '
      .body[] |
      [
        .id,
        .seriesName,
        (if .seasonNumber then "S" + (.seasonNumber | tostring) else "future seasons" end),
        .enabled,
        .onlyNewEpisodes,
        .onlyUnwatched
      ] | @tsv
    ' <<< "${response}"
  } | print_table
}

# jollyfin-cli autodownload list - this device's own local auto-download rules (evaluated by its
# own WorkManager), not the app's separate cross-device rule-push feature.
cmd_autodownload_list() {
  local response
  response=$(local_request "GET" "/autodownload/rules")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  render_autodownload_rules_table "${response}"
}

# jollyfin-cli autodownload add NAME_OR_ID [--season S[,S...]|--all-seasons|--future-seasons]
#                                [--only-new] [--only-unwatched]
# Adds/replaces this device's local auto-download rule for a show - resolves NAME_OR_ID exactly
# like "download NAME" (a UUID-shaped argument routes straight to seriesId instead of a name
# search). Exactly one of --season/--all-seasons picks which existing seasons are covered;
# --future-seasons additionally (or, with none of the others, exclusively) tracks seasons not
# released yet. Giving none of the three still creates a rule - a future-seasons-only one, same as
# leaving every season unchecked in the app's own "add rule" dialog.
cmd_autodownload_add() {
  local positional=() season="" all_seasons="false" future_seasons="false"
  local only_new="false" only_unwatched="false"

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --season)
        season="${2:-}"
        shift 2
        ;;
      --all-seasons)
        all_seasons="true"
        shift
        ;;
      --future-seasons)
        future_seasons="true"
        shift
        ;;
      --only-new)
        only_new="true"
        shift
        ;;
      --only-unwatched)
        only_unwatched="true"
        shift
        ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done

  local name="${positional[0]:-}"
  if [[ -z "${name}" ]]
  then
    printf 'autodownload add requires a show name or item id ("library browse"/"search")\n' >&2
    return 2
  fi

  local id_field="query"
  if [[ "${name}" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
  then
    id_field="seriesId"
  fi

  local seasons_json="null"
  if [[ -n "${season}" ]]
  then
    seasons_json=$(jq -Rc 'split(",") | map(gsub("^\\s+|\\s+$";"")) | map(select(length > 0))' <<< "${season}")
  fi

  local body
  body=$(
    jq -n \
      --arg idField "${id_field}" \
      --arg idValue "${name}" \
      --argjson seasons "${seasons_json}" \
      --argjson all "${all_seasons}" \
      --argjson alsoFutureSeasons "${future_seasons}" \
      --argjson onlyNewEpisodes "${only_new}" \
      --argjson onlyUnwatched "${only_unwatched}" \
      '{($idField): $idValue, all: $all, onlyNewEpisodes: $onlyNewEpisodes, onlyUnwatched: $onlyUnwatched} +
       (if $seasons != null then {seasons: $seasons} else {} end) +
       (if $alsoFutureSeasons then {alsoFutureSeasons: true} else {} end)'
  )

  local response
  response=$(local_request "POST" "/autodownload/rules" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  render_autodownload_rules_table "${response}"
}

# jollyfin-cli autodownload remove NAME_OR_ID - removes every local auto-download rule for a show
# at once (mirrors the app's own delete action: clears every season/future-seasons row for that
# show, not just one). Use "autodownload remove-id" instead to remove just a single rule row.
cmd_autodownload_remove() {
  local name="${1:-}"

  if [[ -z "${name}" ]]
  then
    printf 'autodownload remove requires a show name or item id ("autodownload list"/"search")\n' >&2
    return 2
  fi

  local id_field="query"
  if [[ "${name}" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
  then
    id_field="seriesId"
  fi

  local body
  body=$(jq -n --arg idField "${id_field}" --arg idValue "${name}" '{($idField): $idValue}')

  local response
  response=$(local_request "POST" "/autodownload/rules/remove" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  printf 'Removed %s rule(s)\n' "$(jq -r '.body.removed' <<< "${response}")"
}

# jollyfin-cli autodownload remove-id RULE_ID - removes a single rule row by numeric id (from
# "autodownload list"'s ID column), rather than every rule for its show.
cmd_autodownload_remove_id() {
  local rule_id="${1:-}"

  if [[ -z "${rule_id}" ]]
  then
    printf 'autodownload remove-id requires a RULE_ID (from "autodownload list")\n' >&2
    return 2
  fi

  local body
  body=$(jq -n --arg id "${rule_id}" '{id: $id}')

  local response
  response=$(local_request "POST" "/autodownload/rules/remove" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  printf 'Removed rule %s\n' "${rule_id}"
}

main() {
  local args=()
  local arg

  for arg in "$@"
  do
    if [[ "${arg}" == "--json" ]]
    then
      JSON_OUTPUT=1
    else
      args+=("${arg}")
    fi
  done
  set -- "${args[@]}"

  if [[ -z "${1:-}" ]]
  then
    usage >&2
    return 2
  fi

  case "$1" in
    -h|--help)
      usage
      return 0
      ;;
  esac

  require_deps

  case "$1" in
    token)
      shift
      case "${1:-}" in
        set)
          shift
          cmd_token_set "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    settings|cfg)
      shift
      case "${1:-}" in
        get)
          shift
          cmd_settings_get "$@"
          ;;
        set)
          shift
          cmd_settings_set "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    library|lib)
      shift
      case "${1:-}" in
        list|ls)
          shift
          cmd_library_list "$@"
          ;;
        browse|br)
          shift
          cmd_library_browse "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    search)
      shift
      cmd_search "$@"
      ;;
    sonarr)
      shift
      case "${1:-}" in
        list|ls)
          shift
          cmd_sonarr_list "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    radarr)
      shift
      case "${1:-}" in
        list|ls)
          shift
          cmd_radarr_list "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    seerr)
      shift
      case "${1:-}" in
        requests|req)
          shift
          cmd_seerr_requests "$@"
          ;;
        discover|disc)
          shift
          cmd_seerr_discover "$@"
          ;;
        search)
          shift
          cmd_seerr_search "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    webui)
      shift
      cmd_webui "$@"
      ;;
    download|dl)
      shift
      case "${1:-}" in
        --)
          shift
          cmd_download_by_name "$@"
          ;;
        list|ls)
          shift
          cmd_download_list "$@"
          ;;
        trigger|trig)
          shift
          cmd_download_trigger "$@"
          ;;
        cancel|c)
          shift
          cmd_download_cancel "$@"
          ;;
        remove|rm|del)
          shift
          cmd_download_remove "$@"
          ;;
        "")
          usage >&2
          return 2
          ;;
        *)
          cmd_download_by_name "$@"
          ;;
      esac
      ;;
    debug)
      shift
      cmd_debug "$@"
      ;;
    autodownload|auto)
      shift
      case "${1:-}" in
        list|ls)
          shift
          cmd_autodownload_list "$@"
          ;;
        add|a)
          shift
          cmd_autodownload_add "$@"
          ;;
        remove|rm|del)
          shift
          cmd_autodownload_remove "$@"
          ;;
        remove-id)
          shift
          cmd_autodownload_remove_id "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    version)
      shift
      cmd_version "$@"
      ;;
    start)
      shift
      cmd_start "$@"
      ;;
    stop)
      shift
      cmd_stop "$@"
      ;;
    update)
      shift
      cmd_update "$@"
      ;;
    *)
      printf 'Unknown command: %s\n' "$1" >&2
      usage >&2
      return 2
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]
then
  main "$@"
fi

