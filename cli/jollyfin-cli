  update [--force]                            Self-update: fetch the app's bundled jollyfin-cli
                                              script (GET /cli, no token needed) and replace this
                                              installed copy with it in place. Skips if already
                                              current; --force re-fetches/rewrites anyway

  This CLI's local rule management (above) only ever affects THIS device, evaluated by its own
  WorkManager - distinct from the app's own cross-device "push a rule to another device" feature,
  which isn't exposed here.

Config (environment variables):
  JOLLYFIN_LOCAL_URL     Override the local control server URL (default: ${BASE_URL}) - takes
                         priority over the port JOLLYFIN_PACKAGE_NAME would otherwise pick
  JOLLYFIN_PACKAGE_NAME  Override the app id "start" launches, and which port is assumed
                         (default: ${PACKAGE_NAME}, port ${DEFAULT_LOCAL_PORT}) - set this to
                         a debug/staging install (".debug"/".staging" suffix) and the right
                         port is picked automatically, since each variant binds its own

Options:
  --json      Print the response's body as JSON instead of a table
  -h, --help  Show this help
EOF
}

require_deps() {
  local missing=""

  if ! command -v curl >/dev/null 2>&1
  then
    missing="curl"
  fi

  if ! command -v jq >/dev/null 2>&1
  then
    missing="${missing:+${missing}, }jq"
  fi

  if [[ -n "${missing}" ]]
  then
    printf 'Missing required command(s): %s\n' "${missing}" >&2
    return 2
  fi
}

get_token() {
  if [[ -f "${TOKEN_FILE}" ]]
  then
    cat "${TOKEN_FILE}"
  fi
}

# Pretty-aligns tab-separated stdin into columns on a real terminal (like tsvtool) - passed
# through unchanged when stdout is piped/redirected or `column` isn't installed, so scripts get
# real TSV instead of column-padded text.
print_table() {
  if [[ -t 1 ]] && command -v column >/dev/null 2>&1
  then
    column -t -s $'\t'
  else
    cat
  fi
}

# --json mode: prints just $1's (a local_request response) "body", pretty-printed - the "status"
# wrapper is noise once you're piping into jq (2xx/failure is already the process exit code, same
# as non-JSON mode) - and reports its HTTP status via the return code, used instead of
# check_response's human-readable stderr message.
print_response_json() {
  local response="$1"
  local status

  jq '.body' <<< "${response}"
  status=$(jq -r '.status' <<< "${response}")
  [[ "${status}" -ge 200 && "${status}" -lt 300 ]]
}

# Builds a URL-encoded query string from KEY=VALUE pairs (e.g. "?foo=bar&q=a%20b") - pairs with an
# empty VALUE are skipped, so callers can pass every possible param unconditionally. No non-empty
# pairs -> empty string (no leading "?").
build_query() {
  local pairs=()
  local pair key value

  for pair in "$@"
  do
    key="${pair%%=*}"
    value="${pair#*=}"
    if [[ -z "${value}" ]]
    then
      continue
    fi
    pairs+=("${key}=$(jq -rn --arg v "${value}" '$v | @uri')")
  done

  if [[ ${#pairs[@]} -eq 0 ]]
  then
    return
  fi
  local IFS='&'
  printf '?%s' "${pairs[*]}"
}

# Renders a `{status, body: [{id, name, type, ...}]}` local_request response (jellyfin/libraries,
# jellyfin/items, jellyfin/search all share this shape) as a table.
render_items_table() {
  local response="$1"

  {
    printf 'ID\tNAME\tTYPE\tEXTRA\n'
    jq -r '
      .body[] |
      [
        .id,
        .name,
        .type,
        (
          if .type == "season" then "S" + (.seasonNumber | tostring)
          elif .type == "episode" then
            "S" + (.seasonNumber | tostring) + "E" + (.episodeNumber | tostring) + " (" + .seriesName + ")"
          elif .tmdbId then "tmdb:" + (.tmdbId | tostring)
          else "-"
          end
        )
      ] | @tsv
    ' <<< "${response}"
  } | print_table
}

# Renders a Seerr `{status, body: {results: [...]}}` response (search/discover share this shape).
render_seerr_search_table() {
  local response="$1"

  {
    printf 'TMDB_ID\tTYPE\tTITLE\n'
    jq -r '.body.results[] | [.id, .mediaType, (.title // .name // "-")] | @tsv' <<< "${response}"
  } | print_table
}

cmd_token_set() {
  local token="${1:-}"

  if [[ -z "${token}" ]]
  then
    printf 'token set requires the token value (copy it from Settings > Local CLI access)\n' >&2
    return 2
  fi

  mkdir -p "${CONFIG_DIR}"
  printf '%s' "${token}" > "${TOKEN_FILE}"
  chmod 600 "${TOKEN_FILE}"

  if [[ -n "${JSON_OUTPUT}" ]]
  then
    jq -n --arg path "${TOKEN_FILE}" '{saved: true, path: $path}'
  else
    printf 'Token saved to %s\n' "${TOKEN_FILE}"
  fi
}

# Sends an authenticated request to the app's local control server and prints
# `{"status": <int>, "body": <json-or-null>}`. $1 = method, $2 = path, $3 = body JSON (optional).
local_request() {
  local method="$1"
  local path="$2"
  local body="${3:-}"
  local token response http_status body_out

  token=$(get_token)
  if [[ -z "${token}" ]]
  then
    printf 'No local control token configured.\n' >&2
    printf 'Copy it from JollyFin > Settings > Local CLI access, then:\n' >&2
    printf '  %s token set YOUR_TOKEN\n' "$(basename "$0")" >&2
    return 2
  fi

  local curl_args=(-sS -X "${method}" -H "Authorization: Bearer ${token}" -w '\n%{http_code}')
  if [[ -n "${body}" ]]
  then
    curl_args+=(-H "Content-Type: application/json" -d "${body}")
  fi

  if ! response=$(curl "${curl_args[@]}" "${BASE_URL}${path}")
  then
    printf 'No response from JollyFin local control (is it enabled? URL: %s)\n' "${BASE_URL}${path}" >&2
    return 1
  fi
  http_status="${response##*$'\n'}"
  body_out="${response%$'\n'*}"

  jq -n --argjson status "${http_status}" --argjson body "${body_out:-null}" '{status: $status, body: $body}'
}

# Prints an error and fails if $1 (a local_request response) is a non-2xx status - shared by
# every command except `debug`, which wants to show non-2xx proxied responses too rather than
# treating them as a CLI-level failure.
check_response() {
  local response="$1"
  local status

  status=$(jq -r '.status' <<< "${response}")
  if [[ "${status}" -lt 200 || "${status}" -ge 300 ]]
  then
    printf 'Request failed (HTTP %s): %s\n' \
      "${status}" "$(jq -r '.body.error // "unknown error"' <<< "${response}")" >&2
    return 1
  fi
}

cmd_settings_get() {
  local response

  response=$(local_request "GET" "/settings/downloads")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'KEY\tVALUE\n'
    jq -r '.body | to_entries[] | [.key, .value] | @tsv' <<< "${response}"
  } | print_table
}

# Each KEY=VALUE's value is type-inferred (true/false -> boolean, digits -> number, else string) -
# the app resolves unknown keys as no-ops rather than failing the whole patch, so a newer CLI
# talking to an older app degrades gracefully.
cmd_settings_set() {
  if [[ $# -eq 0 ]]
  then
    printf 'settings set requires at least one KEY=VALUE pair\n' >&2
    return 2
  fi

  local patch="{}"
  local pair key value
  for pair in "$@"
  do
    if [[ "${pair}" != *=* ]]
    then
      printf 'Invalid KEY=VALUE pair: %s\n' "${pair}" >&2
      return 2
    fi
    key="${pair%%=*}"
    value="${pair#*=}"
    patch=$(
      jq -c --arg k "${key}" --arg v "${value}" '
        .[$k] = (
          if $v == "true" then true
          elif $v == "false" then false
          elif ($v | test("^-?[0-9]+$")) then ($v | tonumber)
          else $v
          end
        )
      ' <<< "${patch}"
    )
  done

  local response
  response=$(local_request "PATCH" "/settings/downloads" "${patch}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'KEY\tVALUE\n'
    jq -r '.body | to_entries[] | [.key, .value] | @tsv' <<< "${response}"
  } | print_table
}

cmd_library_list() {
  local response

  response=$(local_request "GET" "/jellyfin/libraries")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  render_items_table "${response}"
}

cmd_library_browse() {
  local parent_id="" search="" type=""

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --search)
        search="${2:-}"
        shift 2
        ;;
      --type)
        type="${2:-}"
        shift 2
        ;;
      *)
        parent_id="$1"
        shift
        ;;
    esac
  done

  if [[ -z "${parent_id}" && -z "${search}" ]]
  then
    printf 'library browse requires a PARENT_ID and/or --search TERM\n' >&2
    return 2
  fi

  local response
  response=$(
    local_request "GET" \
      "/jellyfin/items$(build_query "parentId=${parent_id}" "search=${search}" "type=${type}")"
  )
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  render_items_table "${response}"
}

# Searches the whole server, any item type by default (movies/shows/seasons/episodes/...) - pass
# --type to narrow it, e.g. `search --type episode "Salute Your Morts"` when a title only matches
# an individual episode rather than a show/movie.
cmd_search() {
  local query="" type=""

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --type)
        type="${2:-}"
        shift 2
        ;;
      *)
        query="$1"
        shift
        ;;
    esac
  done

  if [[ -z "${query}" ]]
  then
    printf 'search requires a term\n' >&2
    return 2
  fi

  local response
  response=$(local_request "GET" "/jellyfin/items$(build_query "search=${query}" "type=${type}")")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  render_items_table "${response}"
}

