Configure the real JollyFin app running on this device, from Termux.
Enable it in the app first: Settings > Downloads > Local CLI access.

  token set TOKEN                            Save the token copied from Settings
  settings get                               Show the app's real download settings
  settings set KEY=VALUE [KEY=VALUE...]      Change the app's real download settings
                                              (alias: cfg)
  library list                               List the Jellyfin libraries (Movies, TV Shows, ...)
                                              (alias: lib; list alias: ls)
  library browse [PARENT_ID] [--search TERM] [--type TYPE[,TYPE...]]
                                              Browse a library/folder, or search it. TYPE:
                                              movie|show|season|episode|boxset|folder
                                              (alias: lib; browse alias: br)
  search TERM [--type TYPE[,TYPE...]]        Search the whole Jellyfin server (any item type by
                                              default - use --type to narrow it, e.g. an episode
                                              title that isn't also a show/movie name)
  sonarr list                                List Sonarr series (list alias: ls)
  radarr list                                List Radarr movies (list alias: ls)
  seerr requests [--take N]                  List Seerr requests (alias: req)
  seerr discover [trending|movies|tv] [--page N]  Browse Seerr discover (alias: disc)
  seerr search TERM [--page N]               Search Seerr
  webui SERVICE [--tvdb ID] [--tmdb ID] [--movie] [--open]
                                              Print the web UI URL of SERVICE (sonarr|radarr|
                                              seerr) - a series'/movie's page with --tvdb/--tmdb
                                              (--movie: Seerr movie page instead of TV); --open
                                              opens it via termux-open-url (no custom headers)
  download list [--active|--completed]       List the app's real downloads (--active: only
                                              in-progress, with live percent/speed/eta)
                                              (download alias: dl; list alias: ls)
  download trigger ITEM_ID [SOURCE_ID]       Trigger a real download by item id
                                              (trigger alias: trig)
  download cancel DOWNLOAD_ID                Stop an in-progress download ("download list" DOWNLOAD_ID)
                                              (cancel alias: c)
  download remove ITEM_ID [ITEM_ID...]       Delete an already-downloaded item ("download list" ITEM_ID)
                                              (remove aliases: rm, del)
  download NAME [SEASON] [EPISODE] [--all]   Trigger a real download by name - matches a movie,
                                              show, or a single episode's own title directly, e.g.
                                              download "Rick and Morty" "Season 3"
                                              download "Salute Your Morts"
                                              An item id (from "library browse"/"search") also
                                              works here directly, same as "download trigger ID".
                                              ("list"/"trigger"/"cancel"/"remove" and their
                                              aliases ("ls"/"trig"/"c"/"rm"/"del") are reserved -
                                              a show/movie/episode literally titled one of those
                                              needs "download -- NAME" to force by-name matching,
                                              or "library browse --search" + "download trigger ID")
  debug SERVICE METHOD PATH [BODY_JSON]      Debug request via the app (SERVICE: jellyfin|sonarr|radarr|seerr)
  autodownload list                          List this device's local auto-download rules
                                              (alias: auto; list alias: ls)
  autodownload add NAME_OR_ID [--season S[,S...]] [--all-seasons] [--future-seasons]
                              [--only-new] [--only-unwatched]
                                              Add/replace this device's local auto-download rule
                                              for a show - by name or id ("library browse"/
                                              "search"). --season/--all-seasons pick which
                                              existing seasons are covered (--season accepts a
                                              comma-separated list of numbers/names, e.g. --season
                                              "1,3" or --season "Season 2"); --future-seasons also
                                              tracks not-yet-released seasons and can combine with
                                              either, or stand alone/be omitted entirely for a
                                              future-seasons-only rule
                                              (alias: a)
  autodownload remove NAME_OR_ID              Remove every local auto-download rule for a show, by
                                              name or id (mirrors the app's own delete action -
                                              clears every season/future-seasons rule for that
                                              show at once)
                                              (remove aliases: rm, del)
  autodownload remove-id RULE_ID              Remove a single rule by numeric id ("autodownload
                                              list" ID column)
  version                                     Show this CLI's own version and the running app's
                                              versionName/versionCode/gitRevision
  start                                       Launch the app (via "am start" - works even if it's
                                              not running, so there's nothing to talk to yet; no
                                              root needed)
  stop                                        Ask the running app to exit. No OS-level
                                              force-stop is possible from an unprivileged Termux
                                              process (needs a signature-only permission no
                                              "pm grant" can hand out, even as root) - this asks
                                              the app to exit itself instead, so no root is needed
